# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Ignore bin Folder.
bin/

# Ignore the SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore other unneeded files.
*.swp
*~
.project
.DS_Store
.idea
.secret

# backend 配下のExampleを除いて connect.toml は階層問わずすべて無視
backend/**/connect.toml
!backend/**/connect.toml.example

